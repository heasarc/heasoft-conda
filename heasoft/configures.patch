+    # Allow for case of linker output (e.g. conda) that has a space
+    # between '-L' and the directory path:
+    if test `cat /tmp/$$.log | grep ld | grep -c "L /"` -ne 0; then
+       cxx_lib_paths=`grep ld /tmp/$$.log | sed 's:L /:L/:g' | tr " " "\012" | grep "^-L" | tr "\012" " "`
+    else
+       cxx_lib_paths=`grep ld /tmp/$$.log | tr " " "\012" | grep "^-L" | tr "\012" " "`
+    fi
 fi
