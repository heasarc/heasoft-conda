 $CXX $CXXFLAGS -v -o /tmp/$$.out /tmp/$$.c 2> /tmp/$$.log
 if test `cat /tmp/$$.log | grep -c collect2` -ne 0; then
-    cxx_lib_paths=`grep collect2 /tmp/$$.log | tr " " "\012" | grep "^-L" | tr "\012" " "`
